{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://high5-node-skills/style/rules.schema.json",
    "title": "create-high5-nodes house-style rules",
    "description": "Schema for style/rules.json — the single source of truth for engine and house-style rules this skill enforces or advises on. Note: the constraint 'lintRule === id' cannot be expressed here (JSON Schema has no cross-field-with-itself equality operator scoped to a single sibling pair without duplicating the pattern); scripts/style.mjs validate checks it in code.",
    "type": "object",
    "additionalProperties": false,
    "required": ["$schema", "version", "stance", "overridesFile", "rules"],
    "properties": {
        "$schema": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "stance": { "type": "string", "minLength": 1 },
        "overridesFile": { "type": "string", "minLength": 1 },
        "rules": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/rule" }
        }
    },
    "$defs": {
        "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "class",
                "scope",
                "statement",
                "rationale",
                "enforcedBy",
                "overridable",
                "incorrect",
                "correct",
                "source"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                    "description": "Stable kebab-case id. Doubles as the ESLint rule name when enforcedBy is 'lint'."
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                },
                "class": {
                    "type": "string",
                    "enum": ["house-style", "engine"]
                },
                "scope": {
                    "type": "string",
                    "enum": [
                        "node-name",
                        "category",
                        "description",
                        "input-name",
                        "input-type",
                        "output-name",
                        "output-type",
                        "output-order",
                        "error-message",
                        "imports",
                        "dependencies",
                        "security",
                        "spec",
                        "documentation",
                        "process"
                    ]
                },
                "statement": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One sentence, positive phrasing: what to do."
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One sentence: why the rule exists."
                },
                "enforcedBy": {
                    "type": "string",
                    "enum": ["lint", "typecheck", "agent"]
                },
                "lintRule": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
                    "description": "The ESLint rule name. Required when enforcedBy is 'lint'; must equal 'id' (checked by scripts/style.mjs validate, not expressible here)."
                },
                "overridable": {
                    "type": "boolean",
                    "description": "Must be false for every rule with class 'engine' (checked by scripts/style.mjs validate)."
                },
                "options": {
                    "type": "object",
                    "description": "Tunable values for this rule, only present when the rule has any. Shape is rule-specific."
                },
                "incorrect": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": { "type": "string" }
                },
                "correct": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": { "type": "string" }
                },
                "source": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Reference file and heading this rule was extracted from, e.g. 'references/naming-and-style.md#casing'."
                }
            },
            "if": {
                "properties": { "enforcedBy": { "const": "lint" } }
            },
            "then": {
                "required": ["lintRule"]
            }
        }
    }
}
